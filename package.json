{
	"name": "personal-website",
	"version": "3.1.0",
	"private": true,
	"description": "Dihan Britz's Personal Website for Jobs and Projects",
	"keywords": [
		"jobs",
		"personal",
		"portfolio",
		"projects",
		"website"
	],
	"bugs": "https://github.com/DoubledDoge/personal-website/issues",
	"license": "MIT",
	"author": "DoubledDoge",
	"repository": "git@github.com:DoubledDoge/personal-website.git",
	"type": "module",
	"main": "src/app.html",
	"types": "vite-env.d.ts",
	"scripts": {
		"build": "vite build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"ci": "biome ci --no-errors-on-unmatched",
		"security-audit": "pnpm audit --prod",
		"dev": "vite dev",
		"prepare": "svelte-kit sync",
		"preview": "vite preview"
	},
	"engines": { "node": ">=24" },
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*",
		"#assets/*": "./src/lib/assets/*",
		"#components/*": "./src/lib/components/*",
		"#data/*": "./src/lib/data/*",
		"#styles/*": "./src/lib/styles/*"
	},
	"packageManager": "pnpm@12.18.0",
	"devEngines": {
		"runtime": { "name": "node", "version": "26.13.1", "onFail": "error" },
		"packageManager": { "name": "pnpm", "version": "12.18.0", "onFail": "error" }
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"svelte-meta-tags": "^5.0.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@iconify-json/lucide": "^1.2.154",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/enhanced-img": "^1.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"browserslist": "^4.29.5",
		"lightningcss": "^1.33.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"unplugin-icons": "^24.0.0",
		"vite": "^8.3.8"
	}
}
